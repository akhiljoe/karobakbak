# Template. The npm scripts that use it copy it to `.env.vps` on first use
# (scripts/ensure-env.mjs). Edit the copy, which is gitignored.
#
# Environment for a load run. Not a compose file — the stack is the same one,
# started under a different project name so it gets its own volumes, and
# therefore its own database:
#
#   npm run loadtest          # k6 capacity smoke
#   npm run swarm             # the population test, load-test/swarm/
#
# The load traffic never reaches the development database, which is the point.
# Retention stays enabled: the write-behind path is where load actually hurts,
# and a run that skipped it would prove much less. That is how the retention
# bug in `docs/PROGRESS.md` was found.
# ---------------------------------------------------------------------------
# WHICH FILE THIS IS
# ---------------------------------------------------------------------------
# Compose reads this file twice, for two different jobs, and they are not the
# same job. `--env-file .env.vps` populates ${VAR} substitutions inside the YAML;
# `env_file:` inside a service is what actually puts variables into a container.
# The second one needs a path, and a fixed path would have served development
# values to every profile — so each file names itself here and the service
# reads `${APP_ENV_FILE:-.env}`.
#
# Self-referential on purpose: the value arrives by the same mechanism it
# configures, so a profile that forgets this line falls back to `.env` rather
# than to nothing at all.
APP_ENV_FILE=.env.vps

# Its own port, so it can run beside development rather than fight it for one.
FRONTEND_PORT=8090

# Both loopback spellings, because a person is expected to join this stack and
# the two are *different origins*: the allowlist matches scheme, host and port
# exactly, so a browser pointed at 127.0.0.1 is refused while one pointed at
# localhost is let in.
#
# That failure is worth understanding before shortening this line. The upgrade
# is refused with a 403, the client retries the way it would after any dropped
# connection, and the UI sits on "connecting" — indistinguishable from a server
# that is down. The only place it is visible is
# `chat_connections_rejected_total{reason="origin"}`, which is where it was
# eventually found.
#
# To test from a phone on the same network, add a third entry with **this
# machine's LAN address**. The failure that prevents is silent: the page loads
# over the LAN perfectly (nginx serves it to anyone) and only the WebSocket
# upgrade is refused, so the phone shows a chat UI stuck on "connecting" and
# nothing anywhere says why.
#
# Use your own address (`ipconfig` / `ip addr`), and drop it when you are done.
# A stale entry is harmless: it allows an origin nothing is served on. Adding
# one needs the backends recreated (`npm run loadtest:up`), because it is read
# once at startup.
#
# This is a load-generator convenience. Production lists the one origin it
# actually serves, and an empty list is a startup failure there (R9).
# The rig serves 8091, not the load-test stack's 8090. Copying this file and
# leaving the old port here refused all 500 upgrades with 403 while the swarm
# still reported VERDICT: PASS -- every oracle that could have failed needed a
# conversation to judge, and there were none.
ALLOWED_ORIGINS=http://localhost:8091,http://127.0.0.1:8091

# ---------------------------------------------------------------------------
# PER-BOT ADDRESSES
# ---------------------------------------------------------------------------
# Two trusted hops instead of one. `clientAddress()` counts from the right:
# nginx appends the generator's real address with `$proxy_add_x_forwarded_for`,
# so with two hops the backend selects the entry the *client* sent, and every
# bot gets its own identity.
#
# This is not cosmetic realism. Blocks key on a salted hash of the client
# address, so a swarm sharing one address writes that address into its own
# block set the first time any bot blocks anyone — and `tryMatch` then refuses
# every pair in the run. The failure is silent: matching simply stops.
#
# It also means the per-IP abuse controls can stay at their shipped defaults
# below, so a run measures the product people actually get instead of a
# disarmed version of it.
#
# Load generator only. Production sets the hop count to the real number of
# proxies in front of it: trusting more than that would let a client choose the
# address it is rate-limited and blocked by.
TRUST_PROXY_HOPS=2

# The per-IP controls. Blank uses the shipped defaults. Raise them only for a run that
# deliberately shares one address across many bots (scenario L7) — and then say
# so in the run notes, because the numbers mean something different.
CONN_RATE_LIMIT=
MAX_CONNECTIONS_PER_IP=

# ---------------------------------------------------------------------------
# THE EDGE
# ---------------------------------------------------------------------------
# A proxied WebSocket costs two nginx connections, downstream and upstream, so
# the stock `worker_connections 1024` caps the edge at roughly 512 concurrent
# conversations per worker. That ceiling is hit long before the backend's, and
# it shows up as refused upgrades that look like a backend fault.
NGINX_WORKER_CONNECTIONS=32768

# ---------------------------------------------------------------------------
# MODERATION, SO THE A GROUP HAS SOMETHING TO TRIP
# ---------------------------------------------------------------------------
# Invented nonsense terms, matching `load-test/swarm/corpus/denylist.txt`. A
# deny list in a load test is a list of words that will be written to a real
# database and read by real people during an investigation, and the rule is a
# case-insensitive word match that cannot tell a slur from a nonsense word — so
# there is no reason for it to contain one.
MODERATION_DENY_LIST=zorbleflax,quimbadger,vexnorpil

# The withhold path only exists if some rule escalates to it. Without this the
# default policy flags and delivers everything (D20), and scenario A5 — the one
# that proves a withheld message reaches nobody while still being stored — has
# nothing to exercise. `deny_list` is the right rule to be certain about:
# an operator who configured a term meant it.
MODERATION_HARD_BLOCK_RULES=deny_list

# Nothing on the host: this stack is driven by k6 and by the swarm, and read
# through their summaries.
POSTGRES_HOST_PORT=5435
REDIS_HOST_PORT=6382
PROMETHEUS_PORT=9092
GRAFANA_PORT=3002
# Offset from the development stack so both can run at once; a collision here
# reads as a container that will not start, with the port number as the only clue.
# Priced, unlike the dev stack, so the cost deck can be verified doing
# arithmetic rather than reported as "unpriced" for ever. These are plausible
# small-VM rates and are NOT a quote for anything.
COST_PER_VCPU_HOUR_USD=0.012
COST_PER_GB_MEMORY_HOUR_USD=0.004
COST_PER_GB_EGRESS_USD=0.09
COST_PER_GB_DISK_MONTH_USD=0.10
CADVISOR_PORT=8093
REDIS_EXPORTER_PORT=9124
POSTGRES_EXPORTER_PORT=9188
TEMPO_PORT=3204
TEMPO_OTLP_PORT=4321
LOKI_PORT=3103
ALLOY_PORT=12348

# ---------------------------------------------------------------------------
# THE TWO WINDOWS THE SWARM NOW EXERCISES
# ---------------------------------------------------------------------------
# Both are at their shipped defaults, written out because a load run is the
# only place their *cost* shows up and a reader of a report needs to know what
# they were set to.
#
# The grace window is a held seat: a session that dropped keeps its
# conversation, its match key and its Redis row for this long instead of being
# torn down. At five thousand bots with L personas flapping, that is a standing
# population of sessions the janitor has not reaped yet — visible as session
# keys outliving their sockets, which is correct and would look like a leak
# without this line.
#
# Setting it to 0 restores the pre-section-28 behaviour, where a dropped socket
# ended the conversation (D7). That path is supported and worth a run of its
# own: the L3/L13/L14/L15 personas then measure the old product, and the
# teardown timings can be compared directly.
RESUME_GRACE_SECONDS=20

# How long after a conversation ends a block can still be recorded against the
# partner who left (D38). The M10 persona lives entirely inside this window.
BLOCK_LATE_WINDOW_SECONDS=120

LOG_LEVEL=warn

# --- Tracing (phase 29) -----------------------------------------------------
# Off by default. Spans are the newest path out of the trusted boundary and the
# only one written by libraries rather than by this codebase, so a deployment
# that is not reading traces should not be producing them.
# Off here. Tempo is scaled to zero (it does not run in production either), so
# leaving this on makes the backend resolve a host that is not there on every
# export and burn the one core the measurement is about.
TRACING_ENABLED=false
TRACING_ENDPOINT=http://tempo:4318
TRACING_SERVICE_NAME=karobakbak-backend

# --- Premium preferences and payments (phase 30) ----------------------------
# Preference scoring ON, so the load stack exercises D44 and the D51 entitlement
# gate. With payments off every preference is refused `not_premium`, which is
# the gate being *demonstrated* closed rather than assumed closed — read it in
# chat_preference_limited_total on the product dashboard.
FILTERS_ENABLED=true

# Payments stay OFF here, and turning them on takes two more steps than a flag:
#
#   1. Razorpay test keys. They are deliberately NOT in this file, which is
#      committed. Put rzp_test_ values in your shell or in `.env` and start the
#      stack with them exported; `assertCoherent` refuses PAYMENTS_ENABLED with
#      any of the three missing, by name.
#   2. The schema. `011_payments.sql` is a STAGED migration in
#      `migrations-pending/` — it lands with the flags and the policy patch, not
#      before — so the payment tables do not exist in this database.
#      `npm run payments:migrate:loadtest` applies it to the load stack only.
#
# Without (2) the routes exist and every order fails, which reads as a broken
# integration rather than as a missing table. The end-to-end proof that does not
# need any of this is `tests/integration/payments-e2e.test.ts`, which applies the
# staged migration itself.
PAYMENTS_ENABLED=false

# ---------------------------------------------------------------------------
# VPS RIG OVERRIDES  (docker-compose.vps.yml)
# ---------------------------------------------------------------------------
# Everything above is the load-test stack's configuration, unchanged. What
# follows shapes it like the cheap VPS this will actually be deployed on, so a
# capacity number measured here means something for the machine being paid for.
#
# TIERS. Change these four lines together -- they describe one machine.
#
#   1 vCPU / 1 GB  ~ $6/mo   VPS_CPUSET=0    frontend 128m backend 384m pg 256m redis 128m prom 128m
#   1 vCPU / 2 GB  ~ $12/mo  VPS_CPUSET=0    frontend 192m backend 640m pg 384m redis 256m prom 192m   <-- default
#   2 vCPU / 4 GB  ~ $24/mo  VPS_CPUSET=0,1  frontend 384m backend 1280m pg 768m redis 512m prom 384m
#
# The memory numbers deliberately do not add up to the tier. A real VPS spends
# 200-300 MB on the kernel, systemd and the Docker daemon before a container
# starts, and Postgres reads through the page cache, which lives outside every
# container limit. Allocating the whole 2 GB to containers models a machine
# that does not exist and hides the OOM you would actually hit.
VPS_CPUSET=0
VPS_MEM_FRONTEND=192m
VPS_MEM_BACKEND=640m
VPS_MEM_POSTGRES=384m
VPS_MEM_REDIS=256m
VPS_MEM_PROMETHEUS=192m
VPS_NOFILE=32768

# The edge. 4096 slots is 2048 people, because a proxied WebSocket costs two
# connections -- one down to the browser, one up to the backend. The load-test
# stack sets 32768 because it runs on 8 vCPU and 31 GB; that value here would
# describe an edge the box cannot feed.
NGINX_WORKER_CONNECTIONS=4096
NGINX_WORKER_RLIMIT_NOFILE=16384

# Below the container's 256m, because Redis's own accounting excludes
# fragmentation and the copy-on-write of a fork. `noeviction` is D12: session
# state is not a cache, and evicting a session hash unmatches two people who
# are mid-conversation. Refusing the write is the honest failure.
REDIS_MAXMEMORY=192mb

# Host ports, offset from the load-test stack's. Both stacks otherwise publish
# the same ports and the second to start silently gets none -- the trap
# CLAUDE.md records for the two Sentinel stacks, hit here on the first run.
# Only the frontend is actually reached; the rest are offset so that starting
# this stack never fails on a port the other one holds.
FRONTEND_PORT=8091
POSTGRES_HOST_PORT=5436
REDIS_HOST_PORT=6383
PROMETHEUS_PORT=9094

# Heartbeat experiment (RESULTS.md). The sweep is what a connection costs while
# doing nothing, and it dominates CPU: at 2000 users the idle mix burned 111.7%
# of a core while 80% of it never joined a queue. Must stay under half of
# SESSION_TTL_SECONDS (120) or `assertCoherent` refuses to start.
# Left at the default. Doubling it to 40000 was measured and did nothing:
# +5.7% CPU on the idle mix, +1.7% on realistic, both inside run-to-run noise.
# HEARTBEAT_INTERVAL_MS=40000
