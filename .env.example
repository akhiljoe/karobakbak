# ---------------------------------------------------------------------------
# karobakbak — environment configuration
#
#   cp .env.example .env
#
# THIS FILE IS THE ONE PLACE THE SYSTEM IS TUNED.
#
# Every setting the backend, the persona process and the browser bundle read is
# named here, and `npm run verify` fails if one of them is not — that check
# exists because 108 of them were once settable, documented, and reached no
# process at all (F-045). `docs/CONFIGURATION.md` is the long version.
#
# Three rules worth knowing before changing anything:
#
#   1. Leaving a name blank, or deleting the line, means the default in
#      `backend/src/config.ts` (or `frontend/src/config.ts`). Defaults live
#      there and nowhere else, so nothing here can drift from what ships.
#   2. `VITE_` values are inlined at BUILD time. Changing one needs a rebuild
#      (`docker compose up --build`), not a restart.
#   3. Verify a change by asking the running process, never by re-reading this
#      file:
#        docker exec <container> node -e #          "console.log(require('/app/dist/config').loadConfig(process.env).timers)"
#      For the browser, grep the served bundle. Both have been wrong here in
#      ways nothing reported.
#
# `docker-compose.yml` reads this file twice: for `${VAR}` substitution in the
# YAML, and — via `env_file:` — to put variables inside the container. The
# second is what makes the whole file reach the process; see APP_ENV_FILE below.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# WHICH FILE THIS IS
# ---------------------------------------------------------------------------
# Compose reads this file twice, for two different jobs, and they are not the
# same job. `--env-file .env` populates ${VAR} substitutions inside the YAML;
# `env_file:` inside a service is what actually puts variables into a container.
# The second one needs a path, and a fixed path would have served development
# values to every profile — so each file names itself here and the service
# reads `${APP_ENV_FILE:-.env}`.
#
# Self-referential on purpose: the value arrives by the same mechanism it
# configures, so a profile that forgets this line falls back to `.env` rather
# than to nothing at all.
APP_ENV_FILE=.env

# --- Runtime ---------------------------------------------------------------
# development | production | test
NODE_ENV=development
# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
# Stable id for this backend instance. Leave empty to auto-generate
# (<hostname>-<pid>-<random>). Used for crash detection and Redis beacons.
INSTANCE_ID=

# --- Backend HTTP / WebSocket ----------------------------------------------
# Port the backend listens on (HTTP + WebSocket upgrade share this port).
# 0 means "bind any free port"; used by the socket tests, not in deployment.
BACKEND_PORT=8080
# Interface to bind. 0.0.0.0 inside containers.
BACKEND_HOST=0.0.0.0
# Path the WebSocket upgrade must target. Upgrades to any other path are refused.
WS_PATH=/ws
# Comma-separated list of allowed browser Origin values for the WS upgrade.
# Empty is a WARNING outside production and a STARTUP FAILURE when
# NODE_ENV=production (security doc §6 forbids an allow-any policy).
# Example: http://localhost:5173,http://localhost:8081,https://karobakbak.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# How many reverse proxies sit in front of this process.
# 0 means the peer address IS the client and X-Forwarded-For is ignored.
# Above 0, the client address is read from X-Forwarded-For counting from the
# RIGHT: each trusted proxy appends the address it saw, so the rightmost N
# entries are the ones our own infrastructure wrote. Reading the leftmost entry
# - the usual shortcut - lets a client choose the address it is rate-limited
# and blocked by. Set this to the real number of proxies.
TRUST_PROXY_HOPS=0

# --- Redis -----------------------------------------------------------------
# redis://[:password@]host:port[/db]
REDIS_URL=redis://localhost:6379
# Namespace prefix for every key and pub/sub channel this app creates.
REDIS_KEY_PREFIX=chat
# How long ioredis retries a command while Redis is unreachable, in ms.
REDIS_COMMAND_TIMEOUT_MS=5000

# --- Message limits --------------------------------------------------------
# Maximum characters in a single chat message (UTF-16 code units).
# 500 per security doc §11; also quarters the retained-storage footprint.
MAX_MESSAGE_LENGTH=500
# Maximum characters in a report's free-text note.
MAX_REPORT_NOTE_LENGTH=500
# Maximum accepted WebSocket frame size in bytes. Larger frames close the
# connection with 1009. Must comfortably exceed MAX_MESSAGE_LENGTH * 4.
MAX_FRAME_BYTES=16384
# TTL for a session's rate-limit bucket keys. Bounds rate-limiter memory.
# Must be at least BURST / RATE_PER_SEC for the slowest bucket, which with the
# shipped defaults is REPORT (2 / 0.00167 = ~1200s). A shorter TTL expires a
# partly-spent bucket and hands the sender a full one, silently turning "N per
# hour" into "N per TTL". Startup fails if this is set too low for any
# configured bucket.
RATE_LIMIT_TTL_SECONDS=3600

# --- Per-command rate limits (security doc §12) ----------------------------
# Abuse limits: every value below is blank on purpose. Blank means the shipped
# default from backend/src/config.ts, which is a conservative starting point.
# A public deployment should pick its own and keep them out of the repository.
#
# Each state-changing command gets its own Redis token bucket so cheap protocol
# commands cannot be abused to dodge the message limit.
# RATE is sustained refill per second; BURST is bucket capacity.
# Blank uses the shipped default (3). Set your own in production.
MESSAGE_RATE_PER_SEC=
# Blank uses the shipped default (8). Set your own in production.
MESSAGE_BURST=
TYPING_RATE_PER_SEC=4
TYPING_BURST=8
# Blank uses the shipped default (0.1667). Set your own in production.
JOIN_QUEUE_RATE_PER_SEC=
# Blank uses the shipped default (4). Set your own in production.
JOIN_QUEUE_BURST=
# Blank uses the shipped default (0.25). Set your own in production.
SKIP_RATE_PER_SEC=
# Blank uses the shipped default (5). Set your own in production.
SKIP_BURST=
LEAVE_QUEUE_RATE_PER_SEC=0.333
LEAVE_QUEUE_BURST=6
# Leaving a conversation for the landing screen. Same budget as skip: it is the
# same gesture rate, just without re-entering the queue.
LEAVE_CHAT_RATE_PER_SEC=0.333
LEAVE_CHAT_BURST=6
# Blank uses the shipped default (0.00333). Set your own in production.
BLOCK_RATE_PER_SEC=
# Blank uses the shipped default (3). Set your own in production.
BLOCK_BURST=
# Blank uses the shipped default (0.00167). Set your own in production.
REPORT_RATE_PER_SEC=
# Blank uses the shipped default (2). Set your own in production.
REPORT_BURST=

# --- Connection limits / abuse protection ----------------------------------
# Maximum concurrent WebSocket connections per backend instance.
MAX_CONNECTIONS=5000
# Maximum new connections accepted from one client IP per window.
# Blank uses the shipped default (30). Set your own in production.
CONN_RATE_LIMIT=
CONN_RATE_WINDOW_SECONDS=60
# Maximum CONCURRENT connections from one client IP, counted across all backend
# instances in Redis (security doc §14). Keep generous: mobile carrier NAT,
# universities, offices and CGNAT put many real users behind one address.
# Held as a SET of session ids, not a counter, so slots left behind by a killed
# instance can be reclaimed in place (DESIGN.md §10.20).
# Blank uses the shipped default (20). Set your own in production.
MAX_CONNECTIONS_PER_IP=
# Maximum client message ids remembered per match for replay protection
# (DESIGN.md D24/I14). Reaching it takes sustained maximum-rate sending - at the
# default rate it is over half an hour of it - so the cap is an abuse signal, not
# a conversation length. Messages past it are REFUSED rather than accepted
# without dedupe: accepting would mean a replay is deliverable.
DEDUPE_MAX_ENTRIES=10000
# Invalid/malformed protocol frames tolerated before the connection is closed.
# Blank uses the shipped default (5). Set your own in production.
INVALID_MESSAGE_STRIKES=
# Close a client whose outbound socket buffer exceeds this many bytes (slow
# consumer protection).
MAX_BUFFERED_BYTES=1048576
# Salt used to hash client IPs before they are used as Redis keys.
# Raw IPs are never stored or logged. CHANGE THIS in production.
IP_HASH_SALT=change-me-in-production

# --- TTLs / lifecycle ------------------------------------------------------
# Session record TTL. Refreshed on every client action and by the heartbeat
# loop. A crashed instance's sessions disappear within this window.
SESSION_TTL_SECONDS=120
# Match record and user->match mapping TTL. Outer backstop for stale matches.
MATCH_TTL_SECONDS=3600
# How often the backend refreshes TTLs for its local sessions, in ms.
# Must be well below SESSION_TTL_SECONDS * 1000.
HEARTBEAT_INTERVAL_MS=20000
# Terminate a socket that has not answered a WebSocket ping within this many ms.
CLIENT_TIMEOUT_MS=60000
# Liveness beacon TTL for this instance, used to detect crashed instances.
INSTANCE_HEARTBEAT_TTL_SECONDS=30

# --- Matchmaking -----------------------------------------------------------
# How many random queue candidates to sample per match attempt.
MATCH_CANDIDATE_SAMPLE=8
# Retries when a match attempt aborts due to a concurrent transition.
MATCH_RETRY_ATTEMPTS=3
# Queue segment used when no filters are active. Filters are a reserved seam:
# keys are chat:queue:{segment} and every script takes a segment argument, but
# only this segment is implemented (DESIGN.md §1.2 R6).
DEFAULT_QUEUE_SEGMENT=default

# --- Safety: blocks --------------------------------------------------------
# How long a block stays in force, in seconds (default 30 days).
BLOCK_TTL_SECONDS=2592000
# Block dimensions. The client-token dimension is precise but trivially rotated;
# the IP dimension is coarser, evadable by VPN, and can affect bystanders behind
# CGNAT. Either can be disabled independently (DESIGN.md D18).
BLOCK_DIMENSION_CLIENT_ENABLED=true
BLOCK_DIMENSION_IP_ENABLED=true
# How long after a conversation ends a departed partner can still be blocked.
#
# Blocking races teardown constantly: an abuser sends something and skips, and
# the victim's block lands after the match is already gone. Before this window
# the block recorded nothing and the user was told nothing had gone wrong —
# believing they had blocked somebody they had not (DESIGN.md D38).
#
# The cost is that each side's salted hashes sit against the other's session id
# for this long; that pairing was already implied by the match row it replaces,
# and it expires on its own. Set to 0 to disable the record entirely and restore
# the previous behaviour exactly.
BLOCK_LATE_WINDOW_SECONDS=120

# --- Safety: enforcement ---------------------------------------------------
# Moderator-issued sanctions, checked at the WebSocket upgrade before a session
# is allocated. Distinct from blocks: a block is one user refusing one peer, an
# enforcement is the service refusing a connection outright.
#
# Turning this off stops ban keys being read *or* written, which is the switch
# to reach for if the check ever misfires at the edge.
ENFORCEMENT_ENABLED=true
# What the console offers as a default ban length, in seconds (30 days).
ENFORCEMENT_DEFAULT_BAN_SECONDS=2592000
# Ceiling on any one ban (365 days). A permanent ban is deliberately not
# expressible: an anonymous product has no appeals channel, so an indefinite
# sanction against a salted hash is one nobody can ever lift on evidence.
# Long sanctions are re-issued, which forces a second look.
ENFORCEMENT_MAX_BAN_SECONDS=31536000
# How often each instance replays live sanctions from PostgreSQL into Redis.
#
# Redis runs with persistence switched off (DESIGN.md D12) so that no Redis
# structure can reach disk — which means every ban key dies with a Redis
# restart. PostgreSQL is the durable record and Redis is a cache of it; without
# this pass a ban would last only until the next restart, and nothing would
# report that it had gone.
ENFORCEMENT_RELOAD_INTERVAL_MS=300000

# --- Moderation console ----------------------------------------------------
# Off by default: a deployment that does not moderate opens no port.
#
# The console listens on its OWN port, never the chat server's. The public edge
# proxies the chat port, so a console route sharing that listener would be one
# nginx misconfiguration away from the internet. A separate listener that is
# simply never published cannot be reached by a routing mistake at all.
ADMIN_CONSOLE_ENABLED=false
ADMIN_CONSOLE_PORT=8088
# Loopback, so the console is reached through an SSH tunnel and from nowhere
# else until someone deliberately widens it.
ADMIN_CONSOLE_HOST=127.0.0.1
# Absolute session lifetime in seconds (12 hours), never extended by activity.
# A sliding window keeps a stolen cookie alive exactly as long as it is being
# used, which is the case it most needs to expire in.
ADMIN_SESSION_TTL_SECONDS=43200
# Consecutive failures before an account locks, and for how long. Counted per
# account, so a noisy attacker can lock a real operator out for the window —
# acceptable for a console with one or two accounts, and much better than an
# unbounded guessing budget.
ADMIN_MAX_FAILED_ATTEMPTS=5
ADMIN_LOCKOUT_SECONDS=900
# Login attempts per address per minute, refused before any database work. The
# lockout above bounds guessing at one account; this bounds the cost of
# guessing at many, since each attempt otherwise buys a password hash.
ADMIN_LOGIN_ATTEMPTS_PER_MINUTE=10
# Origins allowed to call the console API. Empty means any, which is a startup
# failure when the console is enabled under NODE_ENV=production: the console
# authenticates with a cookie, so an empty allowlist is cross-site request
# forgery against a live moderator session.
ADMIN_ALLOWED_ORIGINS=

# --- Session resumption ----------------------------------------------------
# How long a dropped socket keeps its seat before the conversation ends.
#
# Reverses DESIGN.md D7, which had a blip end the conversation. A returning
# browser proves it is the same person with a single-use token issued at session
# creation; without one, a reconnect is a new session exactly as before.
#
# 0 disables resumption entirely and restores the original behaviour — the
# teardown tests run against that, so it is a supported configuration.
#
# 20 is a guess. chat_session_resumes_total{outcome="expired"} is the number
# that should replace it: a high expired ratio means the window is shorter than
# the reconnections people actually make.
RESUME_GRACE_SECONDS=20
# Of MAX_CONNECTIONS, the percentage of sockets held back for sessions coming
# back (D63). A returning browser and a first-time visitor arrive through the
# same upgrade, so without this the person whose wifi dropped mid-conversation
# is refused at exactly the moment it is most likely to happen - and a refused
# resumption destroys a live conversation for two people, where a refused
# arrival loses a chat that had not started.
#
# The cost is that cold arrivals are refused at 95% of the ceiling whether or
# not anybody is reconnecting. chat_connections_reserved is published beside
# chat_connections_limit so a dashboard shows the real headroom, and
# chat_resume_reserve_admissions_total is how many conversations the reserve
# actually saved.
#
# Derived to 0 when RESUME_GRACE_SECONDS is 0: seats held for a resumption that
# can never succeed would refuse arrivals to protect capacity nothing can use.
RESUME_RESERVE_PERCENT=5

# --- Safety: moderation ----------------------------------------------------
# Local deterministic rules only. No external classifier until abuse volume
# justifies the spend (cost doc §20-21).
MODERATION_ENABLED=true
# Default action for a rule match: flag | withhold | block.
# Default is flag-and-deliver: classifiers produce signals, not verdicts
# (security doc §22, DESIGN.md D20).
MODERATION_DEFAULT_ACTION=flag
# Comma-separated rule ids that hard-block instead of flagging. Empty = none.
# Validated at startup against the rules that exist: a typo here would silently
# disable a hard block you believed you had configured.
# Known rules: url, email, phone, social_handle, invite_link, crypto_address,
# contact_solicitation, deny_list.
MODERATION_HARD_BLOCK_RULES=
# Comma-separated terms banned outright, matched case-insensitively and as
# whole words. Treated as literal text, never as a pattern.
MODERATION_DENY_LIST=
# Detect URLs, emails, phone numbers, social handles, invites, crypto addresses
# and off-platform contact patterns (security doc §20).
MODERATION_DETECT_CONTACT=true

# --- Presence --------------------------------------------------------------
# How often the server pushes real online/conversation counts, in ms.
# Counts come from Redis cardinality and are cached; they are NEVER fabricated
# (UI spec §5.1).
PRESENCE_INTERVAL_MS=15000

# --- Janitor (stale-state reaper) ------------------------------------------
# How often the janitor runs, in ms. Only the lock holder actually scans.
JANITOR_INTERVAL_MS=15000
# Entries examined per janitor pass, per collection.
JANITOR_BATCH=200
# TTL of the distributed janitor lock, in seconds.
JANITOR_LOCK_TTL_SECONDS=30

# --- PostgreSQL (retained conversation store) -------------------------------
# postgres://user:password@host:port/database
DATABASE_URL=postgres://karobakbak:karobakbak@localhost:5432/karobakbak
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# --- Retention write-behind -------------------------------------------------
# Conversation persistence NEVER blocks message delivery. Messages are queued
# in memory and inserted in batches (DESIGN.md D16).
# Messages are stored as PLAINTEXT application data. Confidentiality comes from
# the trusted boundary in DESIGN.md §2.1 - TLS, private networking,
# least-privilege credentials, storage encryption at rest, encrypted backups -
# NOT from application-level encryption (D15).
RETENTION_ENABLED=true
# Flush when this many rows are buffered...
RETENTION_BATCH_SIZE=100
# How many flush cycles a record may wait for a parent row that another backend
# instance has not written yet. A conversation is created by whichever instance
# won the match, but each participant's messages are flushed by whichever
# instance owns their socket, so a message can legitimately reach the database
# a moment before its conversation. Bounded, so a genuinely orphaned record is
# dropped and counted rather than circulating forever.
RETENTION_MISSING_PARENT_RETRIES=5
# ...or when this many ms have elapsed, whichever comes first.
RETENTION_FLUSH_INTERVAL_MS=1000

# --- Retention queue priority (DESIGN.md D26/D27) ---------------------------
# Capacity is per class and is NOT shared: a flood of ordinary messages can
# never consume the budget reserved for safety records.
#   P0 reports, moderation events, enforcement, audit, conversation rows
#   P1 messages the moderation engine flagged/withheld/blocked
#   P2 messages in a conversation that already had an open report at enqueue
#   P3 ordinary messages
# Priority is assigned by server-side logic only. No client input can raise it.
RETENTION_QUEUE_MAX_P0=2000
RETENTION_QUEUE_MAX_P1=5000
RETENTION_QUEUE_MAX_P2=5000
RETENTION_QUEUE_MAX_P3=20000
# Maximum percentage of any single class one session may occupy. Stops an
# attacker from deliberately tripping a moderation rule to flood the flagged
# class and evict other users' genuine evidence.
RETENTION_QUEUE_SESSION_QUOTA_PCT=10

# --- Database circuit breaker (DESIGN.md D25) -------------------------------
# Consecutive write failures before the circuit opens. A single transient
# failure must not divert traffic to the spool.
BREAKER_FAILURE_THRESHOLD=5
# Initial cooldown before a HALF_OPEN probe, in ms. Backs off exponentially.
BREAKER_COOLDOWN_MS=5000
BREAKER_COOLDOWN_MAX_MS=120000
# Paced drain after recovery. Prevents the backlog replay from knocking the
# database over again the moment it comes back.
BREAKER_DRAIN_BATCHES_PER_SEC=5

# --- Outage spool (DESIGN.md D28, §14.4) ------------------------------------
# Bounded overflow area used while the database circuit is OPEN.
# NOT durable storage: a host or volume failure loses spooled records, and a
# Redis-backed spool additionally loses everything on a Redis restart.
SPOOL_ENABLED=true
# file | redis
SPOOL_BACKEND=file
# Directory for the file spool. Created mode 0700, files mode 0600, owned by
# the non-root application user. Place it on storage with encryption at rest.
# In Docker use a named volume, never a bind mount to a developer machine:
# spooled records are plaintext conversation content.
SPOOL_DIR=/var/lib/karobakbak/spool
# Whichever bound is reached first stops spooling.
SPOOL_MAX_BYTES=134217728
SPOOL_MAX_RECORDS=50000
# Records older than this are dropped on read and counted.
SPOOL_MAX_AGE_SECONDS=86400

# --- Retention periods ------------------------------------------------------
# Stamped onto each row at INSERT time, so changing these values never
# retroactively extends the life of already-stored data (DESIGN.md D17).
# Starting values chosen by the owner; NOT a legal conclusion. Review with
# counsel before public launch.
CONVERSATION_RETENTION_DAYS=30
REPORTED_RETENTION_DAYS=90
REPORT_RETENTION_DAYS=90
MODERATION_EVENT_RETENTION_DAYS=90
ENFORCEMENT_RETENTION_DAYS=90
ADMIN_AUDIT_RETENTION_DAYS=365

# --- Deletion worker --------------------------------------------------------
# Enforces retention. Rows under legal hold are never deleted. A failed pass
# raises an operational alert (DESIGN.md I10).
DELETION_WORKER_ENABLED=true
DELETION_INTERVAL_MS=3600000
DELETION_BATCH=500

# --- Persistence security boundary ------------------------------------------
# There is NO application-level message encryption. Message content is stored
# as plaintext application data (DESIGN.md D15). Its confidentiality depends on
# the controls below actually being configured in the deployment. Read
# DESIGN.md §18.2 for what this does and does not protect against.
#
# Required in any deployment holding real user conversations:
#   [ ] TLS on the client connection (wss://) and on the database connection
#   [ ] PostgreSQL on a private network, no public host port
#   [ ] Application role limited to DML on its own tables; migrations run as a
#       separate role used only at deploy time
#   [ ] Storage/volume encryption at rest for the database AND the spool volume
#   [ ] Encrypted backups, restricted access, defined retention
#   [ ] Backup failures alerting (see BACKUP_* below)
#   [ ] Core dumps and heap snapshots disabled (process memory holds plaintext)
#
# Require TLS on the database connection. Set false only for local development.
DATABASE_SSL=false
# Refuse to start in production if message-content-bearing storage is reachable
# without TLS. Guards against shipping a dev connection string by accident.
DATABASE_REQUIRE_SSL_IN_PRODUCTION=true

# --- Backup monitoring ------------------------------------------------------
# Backups themselves are an infrastructure concern, but their health is an
# application-visible alert: unmonitored backups are equivalent to no backups.
# Alert when no successful backup has been observed within this window.
BACKUP_MAX_AGE_SECONDS=93600
# The shared secret the backup job presents when it reports a run.
#
# Empty means the report route does not exist at all — the correct posture for a
# deployment that is not taking backups, and also the reason `BackupMonitor`
# would stay at `unknown` for ever, which `BackupsNeverObserved` alerts on once
# the process has been up longer than BACKUP_MAX_AGE_SECONDS.
#
# Generate with: openssl rand -base64 32
# The backup container reads the same value from ops/backup/report-token.
BACKUP_REPORT_TOKEN=

# How often the backup job runs, and how many encrypted dumps it keeps.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=7


# --- Observability ---------------------------------------------------------
METRICS_ENABLED=true
METRICS_PATH=/metrics
# Cache duration for Redis-derived global gauges, in ms. Prevents /metrics
# scrapes from hammering Redis.
METRICS_CACHE_MS=2000

# --- Shutdown --------------------------------------------------------------
# Maximum time allowed for graceful shutdown before forced exit, in ms.
SHUTDOWN_TIMEOUT_MS=10000

# --- Frontend --------------------------------------------------------------
# Optional explicit WebSocket URL for the browser. Leave empty to derive it
# from the page origin (ws(s)://<host>/ws), which is what the nginx container
# and the Vite dev proxy both serve.
VITE_WS_URL=
# Host port the frontend container publishes.
FRONTEND_PORT=8081

# --- Monitoring (docker-compose) -------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8092
REDIS_EXPORTER_PORT=9121
POSTGRES_EXPORTER_PORT=9187
TEMPO_PORT=3200
TEMPO_OTLP_PORT=4318
LOKI_PORT=3100
ALLOY_PORT=12345
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Cost model (D62) -------------------------------------------------------
# What the infrastructure costs, so the dashboard can multiply it by what the
# infrastructure is doing. Decimal US dollars, because that is how a hosting
# invoice is written; the application converts to micro-cents internally so the
# whole cost deck shares one unit with the persona spend that already existed.
#
# EVERY ONE DEFAULTS TO ZERO, AND ZERO MEANS UNPRICED, NOT FREE. A plausible
# default here would be believed and would be wrong — a laptop has no bill, and
# a real deployment's rates are known only to its operator.
# `chat_cost_model_configured` is published beside them so a panel can say "no
# prices configured" rather than rendering a confident $0.00/hour.
#
# Egress is the line that scales with users on a WebSocket product, so it is
# the one worth setting first if only one is set.
COST_PER_VCPU_HOUR_USD=0
COST_PER_GB_MEMORY_HOUR_USD=0
COST_PER_GB_EGRESS_USD=0
COST_PER_GB_DISK_MONTH_USD=0

# --- Backups ----------------------------------------------------------------
# Where each encrypted dump is copied after it is written, as an rclone remote
# (for example `b2:<backup-bucket>` or `s3:my-bucket/karobakbak`). Configure
# the remote itself in ops/backup/rclone.conf.
#
# Empty here on purpose: a laptop has nowhere to send one, and every run logs
# that the backup exists only on this host.
#
# NOT OPTIONAL IN PRODUCTION. A dump on a volume attached to the machine running
# the database protects against somebody deleting rows and against nothing that
# takes the host with it.
BACKUP_REMOTE=

# --- Published policies (frontend only, build time) -------------------------
# Where the Terms and the Privacy Policy are published. The age gate links both
# and they must be reachable WITHOUT passing it, so these are required in
# production (docker-compose.prod.yml refuses to build without them).
#
# Empty here on purpose: a development build has nowhere to point, and the gate
# says so on screen rather than linking nothing.
VITE_TERMS_URL=
VITE_PRIVACY_URL=

# --- Advertising (frontend only) -------------------------------------------
# The backend has NO advertising module: ads can never observe or influence
# matchmaking state (DESIGN.md D22/I13). These are build-time frontend values.
VITE_ADS_ENABLED=false
# noop | house
VITE_ADS_PROVIDER=noop
#
# Frequency capping — how often an ad may be shown, at most — is specified in
# the advertising document and is NOT implemented. Three variables for it used
# to be listed here, read by nothing and passed to nothing: configuration
# describing behaviour that did not exist, which is worse than no configuration
# at all, because it reads like a guarantee. They return when the caps do.

# --- Frontend behaviour -----------------------------------------------------
# Values that are the same in every environment — typing-indicator idle time,
# reconnect backoff, message grouping, notice duration — live in
# `frontend/src/config.ts`, not here. Vite inlines VITE_* at build time, so an
# environment variable costs a Dockerfile build arg and a rebuild to change;
# that is worth paying for something that genuinely differs per deployment and
# not for a product decision that does not.
#
# Per-person settings (conversation starters, off by default) are neither: they
# live in the browser, in `frontend/src/preferences.ts`.

# --- Integration tests -----------------------------------------------------
# docker-compose.test.yml publishes throwaway services on non-default ports so
# they never collide with local development instances.
TEST_REDIS_URL=redis://localhost:6380
TEST_DATABASE_URL=postgres://karobakbak:karobakbak@localhost:5433/karobakbak_test

# How long an untriaged report may wait before `ReportsWaitingTooLong` pages.
#
# Exported as a metric so the alert compares against this value rather than
# repeating it — a threshold copied into a rule file drifts the moment somebody
# tunes one and not the other.
#
# Set it to something you will actually meet. A target missed every day is the
# same as no target, except that it also trains you to ignore the alert.
REPORT_RESPONSE_TARGET_SECONDS=86400
REPORT_QUEUE_SAMPLE_MS=60000


# --- payments (Razorpay) ----------------------------------------------------
#
# NOTHING REAL GOES IN THIS FILE. It is tracked in git; `.env` is not. Put the
# actual credentials in `.env` and leave the three below as they are.
#
# Turning payments on is deliberately two decisions, not one. This flag is the
# server half; the browser half is `PAYMENTS_ENABLED` in
# `frontend/src/features.ts`, which is a compiled-in constant because switching
# it on makes two published claims false — the Terms say there is no payment
# provider, and the Privacy page says the site makes no third-party requests
# from the browser. `docs/policies/PENDING-PAYMENTS.md` holds the replacement
# text those documents need, and it lands in the same commit or not at all.
PAYMENTS_ENABLED=false

# The publishable key. Sent to the browser by design, so it is not a secret —
# but it does decide whether money moves. A `rzp_test_` key grants the
# subscription and charges nothing, and nothing at runtime reports that; the
# only signal is a bank statement weeks later. `assertCoherent` refuses to start
# with a test key when NODE_ENV=production, which is the only place that failure
# is ever caught.
RAZORPAY_KEY_ID=

# The API secret, and the webhook signing secret. Two different values — the
# dashboard issues the webhook one per endpoint — and swapping them produces a
# verifier that rejects every delivery, which reads as "webhooks are broken"
# rather than "the wrong secret is configured".
#
# Neither has a fallback in code, on purpose. A default webhook secret means a
# deployment that forgot the variable accepts webhooks signed with a string
# published in this repository, and the symptom is not an error — it is a
# stranger granting themselves premium. The process refuses to start instead.
#
# The webhook secret is a shared HMAC key, so make it random rather than
# memorable. Anyone who can guess it can forge a `payment.captured`.
#   openssl rand -hex 32
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Order-creation attempts per IP hash per window, and the window. Creating an
# order costs a round trip to Razorpay and a database row, so the limit is far
# tighter than the connection one. 10 an hour by default.
PAYMENTS_CREATE_RATE_LIMIT=10
PAYMENTS_CREATE_RATE_WINDOW_SECONDS=3600

# Ceiling on a request body on either payment route. The webhook is
# unauthenticated until its signature is checked, and the signature covers the
# body — so the whole body is buffered before anything about the sender is
# known. This number is what makes that safe.
PAYMENTS_MAX_BODY_BYTES=65536

# How long a payment record is kept. Longer than anything else in this file,
# because a financial record has a statutory period rather than a chosen one.
# The default is seven years. Nothing sweeps these tables yet.
PAYMENT_RECORD_RETENTION_DAYS=2555

# Where the footer's "Buy me a coffee" points while payments are off. Empty
# hides the link entirely rather than pointing it nowhere.
VITE_SUPPORT_URL=

# The address the Contact page and footer show.
VITE_CONTACT_EMAIL=contact@karobakbak.com

# --- Sign-in (OIDC / Cognito, §32, D48) ------------------------------------
# Signing in is FREE and gates saved connections, recent history and friend
# requests. It is not coupled to payments (§31) — do not gate it on
# PAYMENTS_ENABLED.
#
# Off by default. AUTH_ENABLED=true with any of AUTH_ISSUER, AUTH_AUTHORIZE_URL,
# AUTH_TOKEN_URL, AUTH_JWKS_URL, AUTH_CLIENT_ID or AUTH_REDIRECT_URI empty is a
# startup error, by name: a sign-in button that renders and lands on a provider
# error page reads as "sign-in is broken" rather than "sign-in is not
# configured".
AUTH_ENABLED=false

# Checked against the `iss` claim, so it must match the pool exactly. Must be
# https — an http issuer is refused, because the symptom otherwise is a
# successful token exchange followed by "invalid token", which points at the
# token rather than at the pool.
AUTH_ISSUER=

# The provider's OAuth endpoints. On Cognito these live on the *hosted UI
# domain*, which is a different host from the issuer above — a pool has both,
# and using the issuer host here is the common first mistake.
AUTH_AUTHORIZE_URL=
AUTH_TOKEN_URL=

# Where the signing keys are published. Verified natively; there is no JWT
# library (see CLAUDE.md).
AUTH_JWKS_URL=

# The app client. The secret is only required for a confidential client — a
# public client leaves it empty. Never commit a real value: this file is
# tracked, `.env` is not.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# THE ORIGIN THE BROWSER SEES, not the backend's own address. The backend
# publishes no host port in either compose file; /auth/* is proxied through the
# frontend container, so this is scheme + host + FRONTEND_PORT + /auth/callback
# and it must be registered on the provider byte-for-byte.
#   local  http://localhost:8081/auth/callback   (or whatever FRONTEND_PORT is)
#   prod   https://<domain>/auth/callback
AUTH_REDIRECT_URI=

# A federated identity provider to go straight to, named exactly as it is
# spelled in the pool — `Google`, `Facebook`, `SignInWithApple`, or the name of
# a SAML/OIDC provider you added.
#
# Empty renders the provider's own hosted login form. Set, it is passed as
# `identity_provider` on the authorize URL, the hosted form is skipped and the
# browser lands on that provider's consent screen one redirect later.
#
# It must already exist on the pool AND be ticked on the app client — the second
# is the step that gets missed, because adding the provider looks like it
# finished the job.
#
# Naming one that is not enabled fails quietly: Cognito redirects to its own
# login page with `errorMessage=Login option is not available` in the query and
# renders the ordinary email form. The symptom is therefore the exact screen
# this setting exists to skip, which reads as "the setting does nothing".
AUTH_IDENTITY_PROVIDER=

# Whether to show the provider's profile picture on the account control.
#
# Off by default, and it is not only a display toggle: with it on the authorize
# request adds the `profile` scope, so the provider must be configured to grant
# it. On Cognito that means `profile` in the Google IdP's authorized scopes AND
# `Profile` ticked on the app client — ask for a scope the client cannot grant
# and the whole sign-in fails with `invalid_scope`.
#
# The image is fetched server-side and relayed by `/auth/avatar`; the vendor's
# CDN URL never reaches a browser, so `img-src 'self'` and the Privacy Policy's
# "no third-party requests" both stay true. Only the URL is kept, on the sign-in
# credential in PostgreSQL (020), and cleared on sign-out and expiry — never the
# image itself.
#
# It is account-scoped and never part of the declared profile: no chat partner
# and no matchmaking path can read it.
AUTH_AVATARS=false

# Where the callback sends the browser once a session exists. Also the value to
# register as the provider's sign-out URL, resolved against the same origin.
AUTH_RETURN_URL=/

# Thirty days, then ten minutes for a redirect in flight. Both have defaults.
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_FLOW_TTL_SECONDS=600

# How long an account survives without a sign-in, in days (D66). Every sign-in
# restamps it; once it passes, the deletion worker removes the account with its
# friendships, nicknames and credentials. Suspended accounts are kept. Must be
# longer than AUTH_SESSION_TTL_SECONDS or the process refuses to start.
AUTH_ACCOUNT_RETENTION_DAYS=365

# The session cookie is a bearer credential. False is for plain-HTTP localhost
# ONLY, where a Secure cookie is never stored and sign-in silently does
# nothing; loadConfig refuses false when NODE_ENV=production.
AUTH_SECURE_COOKIES=true

# --- Tracing (phase 29) -----------------------------------------------------
# Off by default. Spans are the newest path out of the trusted boundary and the
# only one written by libraries rather than by this codebase, so a deployment
# that is not reading traces should not be producing them.
TRACING_ENABLED=false
TRACING_ENDPOINT=http://tempo:4318
TRACING_SERVICE_NAME=karobakbak-backend

# --- Capacity derivation (phase 35, D63) ------------------------------------
# The ceiling is derived from the box: cores x CONNECTIONS_PER_CORE, with
# MAX_CONNECTIONS above overriding it entirely when set. 1400 is the measured
# figure for one vCPU (docs/testing/RESULTS.md, 2026-09-02) and sits at the
# gentle end of the range on purpose - a cap exists to prevent collapse, not to
# hold the service at its optimum.
CONNECTIONS_PER_CORE=1400

# --- Rate limits that were undocumented until phase 38 ----------------------
# Reactions and saved connections. Both follow the same shape as every other
# bucket: a sustained rate and a burst allowance.
REACT_RATE_PER_SEC=1
REACT_BURST=5
SAVE_CONNECTION_RATE_PER_SEC=0.1
SAVE_CONNECTION_BURST=4

# --- Premium matching preferences (phase 18, D44) ---------------------------
# The paid preference itself is FILTERS_ENABLED, and it is derived rather than
# absolute: FILTERS_AVAILABLE is FILTERS_ENABLED && PAYMENTS_ENABLED, because
# only the `default` queue segment exists (R6, D23) and filtering is the paid
# tier. Each half refuses for its own reason, so one flag would let one of them
# be forgotten.
FILTERS_ENABLED=false

# The two limits D44 depends on. They key on the IP hash, not the session -
# every other limiter here keys on a session, which is one connection and free
# to replace. Cooldown runs from the last *grant*, not from a match ending
# (DESIGN.md 29.4 records why the document's literal wording was not followed).
# Blank uses the shipped default (15000). Set your own in production.
PREFERENCE_COOLDOWN_MS=
# Blank uses the shipped default (60). Set your own in production.
PREFERENCE_HOURLY_BUDGET=
# The second, wider candidate sample taken only when a preference is declared.
PREFERENCE_WIDE_SAMPLE=32

# --- Redis Sentinel (OPERATIONS.md 17) --------------------------------------
# Empty means a single node at REDIS_URL. A half-specified topology is refused
# at startup rather than degraded to one node: naming sentinels without a
# master name is a config that looks highly available and is not.
REDIS_SENTINELS=
REDIS_SENTINEL_NAME=
# The nodes' password and the sentinels' password are usually different, which
# is why they are two names rather than one.
REDIS_PASSWORD=
REDIS_SENTINEL_PASSWORD=

# --- Payments (phase 30, off) -----------------------------------------------
# The currency orders are created in. Razorpay settles in INR.
PAYMENTS_CURRENCY=INR

# --- AI personas (optional, off by default) ---------------------------------
# Optional automated conversation partners. They never claim to be human, a
# guard layer enforces their limits, and spend is capped monthly (below).
# PERSONAS_ENABLED starts the process; the persona_control table decides
# whether anything may join, and it ships disabled. Turning it on is an
# audited switch in the moderation console. Both must say yes.
PERSONAS_ENABLED=false

# Optional JSON file of extra guard terms for personas, read at startup. The
# path is inside the personas container, so mount the file with a compose
# override. Shape: ops/personas/guard-terms.example.json. Detection lists in
# the file are added to the built-in ones and can never shorten them; the two
# reply lists replace the built-in wording. An invalid file stops the service.
PERSONA_GUARD_TERMS_FILE=

# Provider, model and price are one decision in three variables, and
# assertCoherent refuses all three ways of getting them out of step - every one
# of which fails quietly. The sharpest is one vendor's model id against the
# other's key: it authenticates fine, then fails every call, and the scripted
# fallback hides it completely.
PERSONA_PROVIDER=anthropic
PERSONA_MODEL=claude-haiku-4-5
# Empty means no model at all: personas run on the scripted voice and cost
# nothing. That is a supported configuration, not a broken one.
PERSONA_API_KEY=

# TypeSafe Jev: a decision model beside the voice, never the voice (it writes no
# text). It classifies each turn (greeting, question, ...), checks a drafted
# reply answers what was said, and adds a second opinion to the persona safety
# limits - additive only, the word lists always run. Empty key means off, and
# every judgement comes from rules. Any failure (timeout, 4xx/5xx, bad body,
# breaker open) falls back to rules for that turn.
JEV_API_KEY=
JEV_API_URL=https://api.typesafe.ai
# A second host speaking the same /v1/systemone API (a gateway or proxy), tried
# when the first fails or its breaker is open. Its key defaults to JEV_API_KEY.
JEV_FALLBACK_API_URL=
JEV_FALLBACK_API_KEY=
JEV_MODEL=jev-latest
# One attempt per host per turn; the reply is waiting on it.
JEV_TIMEOUT_MS=2500
# Consecutive failures before a host is skipped, and for how long.
JEV_BREAKER_THRESHOLD=3
JEV_BREAKER_COOLDOWN_MS=60000
# A Jev flag counts only at or above this probability.
JEV_MIN_CONFIDENCE=0.8
# Micro-cents of US dollars per million input tokens ($0.06). Output is free.
# Charged against PERSONA_MONTHLY_LIMIT_MICRO_CENTS like every other call.
JEV_INPUT_MICRO_CENTS_PER_MTOK=6000000

# Report triage in the moderation console (D-AI-14). Only conversations a user
# REPORTED are sent to Jev; ordinary chats never leave the server. Runs in the
# console process, audited like a moderator's read. Shadow mode by default:
# urgency is shown on each report and the queue stays oldest-first until
# JEV_TRIAGE_SORT=true. If Jev fails, the report shows a rules estimate from
# the reporter's chosen category and is retried up to JEV_TRIAGE_MAX_ATTEMPTS.
JEV_TRIAGE_ENABLED=true
JEV_TRIAGE_SORT=false
JEV_TRIAGE_INTERVAL_MS=60000
JEV_TRIAGE_CONTEXT_MESSAGES=40
JEV_TRIAGE_MAX_ATTEMPTS=3

# Concurrency. PERSONA_MAX_CONCURRENT must stay below MAX_CONNECTIONS_PER_IP -
# every persona connects from the same address and they share one bucket, so a
# cap above the connection limit looks applied and silently is not.
PERSONA_MAX_CONCURRENT=8
PERSONA_MAX_PER_CHARACTER=2

# Dispatch pacing: the tick, the minimum gap between two dispatches, the wait
# before a persona is considered, and the silence timeout.
PERSONA_TICK_INTERVAL_MS=3000
PERSONA_MIN_DISPATCH_GAP_MS=6000
PERSONA_WAIT_BEFORE_FILL_SECONDS=25
PERSONA_SILENCE_TIMEOUT_SECONDS=120

# An optional daily window, in local time (UTC plus the offset in minutes).
# Both hours zero means all day.
PERSONA_ACTIVE_START_HOUR=0
PERSONA_ACTIVE_END_HOUR=0
PERSONA_UTC_OFFSET_MINUTES=330

# The spend ceiling, in micro-cents of US dollars - the unit MODEL_PRICES uses,
# so persona spend and the cost deck are directly summable. It lives in
# PostgreSQL as well, because Redis persistence is off (D12) and a spend
# counter that resets on restart is not a budget.
#
# THE ARITHMETIC, BECAUSE IT IS EASY TO BE WRONG BY A FACTOR OF 100 OR 1000.
# A micro-cent is a millionth of a CENT, not of a dollar (`MC = 1_000_000` in
# personas/provider.ts). So:
#
#     $1.00  =        100_000_000
#     $5.00  =        500_000_000
#     $2.00  =        200_000_000   <- the value this file used to carry
#
# `formatMicroCents` is the check: microCents / (100 * 1_000_000) is dollars,
# which is what the console prints in the persona panel.
#
# The floor is 1, and PersonaBudget refuses to construct at all on a value of
# zero or less - a ceiling that cannot bind is not a ceiling.
PERSONA_MONTHLY_LIMIT_MICRO_CENTS=500000000

# How long the kill switch is cached before being re-read.
PERSONA_CONTROL_CACHE_TTL_SECONDS=20

# ===========================================================================
# Values that were hard-coded until phase 38
# ===========================================================================
# Everything below was a constant in a source file: correct, commented, and
# impossible to change without a rebuild. Every default here is the number that
# was compiled in, so a deployment that sets none of them behaves as before.

# --- Sign-in: the OIDC round trips -----------------------------------------
# Clock skew allowed on `exp` and `iat`. Not zero, because the provider's clock
# and this one disagree by a little and a token rejected for being one second
# early is a sign-in that fails for nobody's reason. Not large either: every
# second here is a second an expired token keeps working.
OIDC_CLOCK_SKEW_SECONDS=60
# The floor between two JWKS re-fetches. An unknown `kid` triggers one, and an
# attacker can produce unknown kids at will - without a floor this is a request
# amplifier pointed at the identity provider.
OIDC_JWKS_MIN_REFETCH_MS=60000
OIDC_JWKS_TIMEOUT_MS=5000
# Longer than the JWKS fetch: the token exchange is one round trip on the
# critical path of somebody waiting to be signed in.
OIDC_TOKEN_TIMEOUT_MS=10000

# --- Sign-in: the avatar relay ----------------------------------------------
# The ceiling is enforced on bytes actually read, never on Content-Length,
# which the sender chooses. Generous for a 96px avatar.
AVATAR_MAX_BYTES=131072

# How long before the same friend can be asked again. Blank uses the shipped
# default (120). Set your own in production.
FRIEND_ASK_COOLDOWN_SECONDS=
# A sign-in is a person waiting; a slow CDN must not become a slow sign-in.
AVATAR_FETCH_TIMEOUT_MS=4000
# How long a browser may cache a relayed avatar. `private`, so it is the
# viewer's own cache. Long, because the image changes only when somebody
# changes their provider picture.
AVATAR_CACHE_SECONDS=86400

# --- Premium entitlement cache (D51) ----------------------------------------
# Negatives are cached too, and almost every account is a negative - which is
# what makes the cache worth having. An entitlement bought inside the window
# applies late, and D51 already makes it apply on the next connection rather
# than the next search, so this changes nothing a user can perceive.
PREMIUM_CACHE_SECONDS=300

# --- Moderation console -----------------------------------------------------
# Every console request is a small JSON object. Generous for all of them and
# small enough that an unauthenticated caller cannot make the process buffer
# anything.
ADMIN_MAX_BODY_BYTES=16384
# The window ADMIN_LOGIN_ATTEMPTS_PER_MINUTE is counted against. The budget was
# configurable and the window was not, which makes the name a lie the moment
# either moves.
ADMIN_LOGIN_WINDOW_MS=60000

# --- Redis reconnection -----------------------------------------------------
# Attempt N waits N x step, capped. Reconnection is routine rather than
# exceptional: D12 keeps no persistence, so Redis may restart empty at any time.
REDIS_RETRY_STEP_MS=200
REDIS_RETRY_MAX_MS=5000
# The boot deadline for both connections. A process that cannot reach Redis has
# nothing to serve, and /ready is derived from Redis alone.
REDIS_READY_TIMEOUT_MS=10000

# --- Matchmaking observation ------------------------------------------------
# How many waiting sessions the queue-composition gauge samples. A gauge, not a
# decision - nothing matches on it. Sampling keeps the observation off the hot
# path; the cost is that shares are approximate on a very large queue, which is
# where they matter least.
QUEUE_COMPOSITION_SAMPLE=500

# --- Preference token bucket (D44, D18) -------------------------------------
# How long the bucket survives with no activity. Deliberately not the session
# TTL: it outlives any one connection, or reconnecting would clear it - and
# replacing a connection is the first thing somebody hunting would do.
PREFERENCE_BUCKET_TTL_SECONDS=7200

# --- Database and the write-behind path -------------------------------------
# How long an idle pooled connection is kept. Not a safety control: it trades a
# reconnection against holding a server-side session open.
DATABASE_IDLE_TIMEOUT_MS=30000
# How many unobserved batch durations to keep. Bounded so a process with
# metrics switched off does not accumulate an array for its whole life.
RETENTION_PENDING_DURATIONS_MAX=512

# --- What is for sale (phase 30, off) ---------------------------------------
# In paise, because that is the unit Razorpay charges in - a rupees field that
# gets multiplied somewhere is an extra place for a factor of 100 to go missing.
#
# THE PREMIUM PAGE STATES THIS PRICE IN PROSE. Nothing can check that for you:
# change this and PremiumPage.tsx changes in the same commit, or the page
# advertises a price the checkout does not charge.
PREMIUM_PRICE_PAISE=9900
PREMIUM_GRANT_DAYS=30
# A donation grants nothing - buying goodwill is not an entitlement, and the
# Support page says so. These bound a gift rather than a purchase.
DONATION_MIN_PAISE=5000
DONATION_MAX_PAISE=5000000

# --- Persona message timing (D-AI-5) ----------------------------------------
# How a persona reply is paced and split into messages. The intervals only make
# sense against each other, which is why they are one block: moving one usually
# means looking at the rest. Defaults live in backend/src/config.ts.
#
# Reading the incoming message, before typing starts.
PERSONA_READ_MS_PER_CHAR=22
PERSONA_READ_FLOOR_MS=400
PERSONA_READ_CEILING_MS=4000
# Typing one bubble.
PERSONA_TYPE_MS_PER_CHAR=90
PERSONA_TYPE_FLOOR_MS=700
PERSONA_TYPE_CEILING_MS=6000
# Between the end of one bubble and the start of the next.
PERSONA_GAP_FLOOR_MS=500
PERSONA_GAP_SPREAD_MS=900
# A pause before typing starts.
PERSONA_THINK_FLOOR_MS=300
PERSONA_THINK_SPREAD_MS=1200
# How a reply is split into messages. A newline is always a break; these
# decide the rest. Every bubble is a frame against the message rate limit.
PERSONA_BUBBLE_SOFT_CHARS=90
PERSONA_BUBBLE_KEEP_WHOLE_BELOW=60
PERSONA_MAX_BUBBLES=3
# The opening of a conversation, where a model reliably says too much. Three
# turns is the span in which a real conversation is still deciding whether it
# is a conversation.
PERSONA_OPENING_TURNS=3
PERSONA_OPENING_MAX_WORDS=12
# How long after the stranger's last message a reply starts being written, so
# a burst ("hi" / "kaha se ho") gets one answer to all of it. Counts toward the
# reading pause rather than adding to it. 0 answers every message on its own.
PERSONA_COALESCE_MS=1800

# --- Persona behaviour and spend --------------------------------------------
# Identical messages in a row before a persona decides this is not a person.
# Three rather than two: a person genuinely does repeat themselves once when
# they think a message did not send.
PERSONA_REPEATS_BEFORE_LEAVING=3
# How many recent turns the model is shown, and the ceiling on one reply. The
# window dominates prompt cost, so it is the first thing worth moving when the
# bill matters - and the character sheet is the LAST, because trimming below the
# minimum cacheable prefix silently stops caching and costs more.
PERSONA_CONTEXT_TURNS=10
PERSONA_MAX_OUTPUT_TOKENS=300
# Headroom for a reasoning model's hidden tokens. Sized only for the visible
# reply, the call comes back empty - which falls back to the scripted voice and
# looks like a model with nothing to say rather than a budget that was too small.
PERSONA_REASONING_HEADROOM_TOKENS=1000
# How many messages the scripted voice sends before it runs dry.
PERSONA_SCRIPTED_MAX_MESSAGES=12
# How often a generated surface declines to give a name, or declines a field.
PERSONA_NO_NAME_CHANCE=0.12
PERSONA_DECLINE_CHANCE=0.08

# --- Client-side timings (build time, phase 38) -----------------------------
# VITE_ values are inlined by vite at BUILD time, so changing one needs a
# rebuild, and each has to appear in three places: here, in the compose
# build.args, and as a Dockerfile ARG/ENV pair. `npm run verify` checks all
# three; dropping any one of them ships the default with nothing to show for it.
#
# Every one of these is a duration something waits on, so 0, a negative and an
# unparseable value all fall back to the compiled default rather than being
# taken literally - a 0 would turn the backoff into a spin and every timeout
# into an instant failure, and both read as a broken server.
#
# Blank means the default in frontend/src/config.ts, which is the one place a
# default lives.

# How long after the last keystroke the typing indicator is withdrawn.
VITE_TYPING_IDLE_MS=
# Reconnect backoff, in order, comma-separated. The last entry repeats for
# every attempt after it, so the shape matters: a one-element list is a fixed
# interval. Half the delay is jittered by the client either way.
VITE_RECONNECT_BACKOFF_MS=
# Two messages from the same side closer together than this are grouped into
# one visual block. Purely presentational.
VITE_MESSAGE_GROUPING_MS=
# How long a transient notice stays on screen.
VITE_TOAST_VISIBLE_MS=
# How long to wait for the capacity probe (DESIGN.md 28.9) before giving up.
# Short on purpose: an answer that arrives after the next reconnect succeeded
# would explain a failure that is already over.
VITE_CAPACITY_PROBE_TIMEOUT_MS=
# How long auto-search waits after a rate-limited search before retrying.
VITE_AUTOSEARCH_BACKOFF_MS=
# How long to wait for the payment provider's checkout script.
VITE_CHECKOUT_LOAD_TIMEOUT_MS=
