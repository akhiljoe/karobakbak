# dependencies
node_modules/
.pnp/
.pnp.js

# build output
dist/
build/
*.tsbuildinfo

# environment
.env
.env.local
.env.*.local
# Real production secrets. `.env.prod.example` is the template and is tracked;
# the filled-in file must never be.
.env.prod
!.env.example
!.env.prod.example
# Tracked on purpose: it holds no secrets, only the port and abuse-limit
# overrides a load run needs.
!.env.loadtest

# Local payment testing. Reads RAZORPAY_WEBHOOK_SECRET out of `.env` to sign a
# simulated `payment.captured`, so it is a script that handles a secret and has
# no business being tracked. It also only ever posts to localhost — committing
# it would put a webhook forger in the repository for anyone who later points
# it somewhere else.
fake-webhook.sh

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# test / coverage
coverage/
.nyc_output/
junit.xml

# load test output
load-test/results/
*.k6-summary.json
# Swarm run artefacts: ledgers hold no message text (hashes only), but they are
# large and they are evidence about one run, not about the code.
load-test/swarm/runs/

# runtime volumes
data/
# The alert webhook URL is a bearer credential: anyone holding it can post
# alerts that look like they came from this service. The .example beside it is
# committed; this is not.
monitoring/alertmanager/webhook-url

# The backup passphrase. Losing it means losing every backup it encrypted, so
# it belongs in a password manager as well as here — and never in git.
ops/backup/passphrase
ops/backup/report-token
# rclone's remotes, which hold credentials for the store every encrypted dump
# is copied to. Same reasoning as the passphrase above.
ops/backup/rclone.conf

monitoring/grafana/data/
monitoring/prometheus/data/

# editors / OS
.vscode/
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
