{
  "name": "@karobakbak/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Random stranger chat backend: WebSocket gateway + Redis-authoritative matchmaking.",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:all": "npm run test && npm run test:integration"
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.5.13",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
