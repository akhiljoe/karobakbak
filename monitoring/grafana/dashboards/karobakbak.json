{
  "uid": "karobakbak-overview",
  "title": "karobakbak — overview",
  "tags": [
    "karobakbak"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "title": "Conversations",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Connections and matches",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(chat_connections_active)",
          "legendFormat": "connected"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "max(chat_active_matches)",
          "legendFormat": "conversations"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "max(chat_queue_depth)",
          "legendFormat": "waiting"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Message throughput",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_messages_received_total[1m]))",
          "legendFormat": "received/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (route) (rate(chat_messages_delivered_total[1m]))",
          "legendFormat": "delivered {{route}}/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (reason) (rate(chat_messages_rejected_total[1m]))",
          "legendFormat": "rejected {{reason}}/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Matchmaking latency",
      "description": "Time from joining the queue to being matched. Dominated by how many other people are waiting, not by the server.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chat_matchmaking_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chat_matchmaking_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Refusals",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (reason) (rate(chat_connections_rejected_total[5m]))",
          "legendFormat": "upgrade {{reason}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (command) (rate(chat_rate_limited_total[5m]))",
          "legendFormat": "rate limited {{command}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Safety",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "Reports, blocks and moderation",
      "description": "Moderation flags are rule outcomes by action. No panel here can show what a rule matched: flags carry rule ids only (I8).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_reports_total[15m]))",
          "legendFormat": "reports/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_blocks_total[15m]))",
          "legendFormat": "blocks/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (action) (rate(chat_moderation_flags_total[15m]))",
          "legendFormat": "{{action}}/s"
        }
      ]
    },
    {
      "type": "row",
      "title": "Retention",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "type": "timeseries",
      "title": "Write-behind queue by class",
      "description": "Capacity is per class and is not shared: a full P3 cannot consume P0's budget (D26).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (class) (chat_retention_queue_depth)",
          "legendFormat": "{{class}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Dropped records",
      "description": "Every drop is counted. P0 dropping is page-worthy: it means safety evidence is being lost.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (class, reason) (rate(chat_retention_dropped_total[15m]))",
          "legendFormat": "{{class}} {{reason}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Database circuit breaker",
      "description": "0 closed · 1 half-open · 2 open. Open means chat is fine and retention is degraded (D25).",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "max(chat_db_breaker_state)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outage spool",
      "description": "Bounded tolerance for a database outage. Not durable storage (D28).",
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 6,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(chat_spool_records)",
          "legendFormat": "records"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_spool_drained_total[5m]))",
          "legendFormat": "drained/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_spool_corrupt_records_total[5m]))",
          "legendFormat": "corrupt/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rows deleted by retention",
      "description": "Expiry is enforced, not intended (I10). A flat line with data in the database is the failure.",
      "gridPos": {
        "h": 5,
        "w": 9,
        "x": 15,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (table) (rate(chat_retention_deleted_total[30m]))",
          "legendFormat": "{{table}}/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_deletion_failures_total[30m]))",
          "legendFormat": "failures/s"
        }
      ]
    },
    {
      "type": "row",
      "title": "Sessions, resumption and profiles",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 40
      }
    },
    {
      "type": "timeseries",
      "title": "Reconnections that kept their conversation",
      "description": "A dropped socket no longer ends a conversation (D42). `expired` is the number to watch: it counts reconnections that arrived after the grace window, and each one was a conversation that ended when it did not have to.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (outcome) (rate(chat_session_resumes_total[5m]))",
          "legendFormat": "{{outcome}}/s"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_disconnects_total[5m]))",
          "legendFormat": "disconnects/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Declared profiles refused",
      "description": "A declared name is refused outright when any moderation rule fires (D35), unlike a message, which is flagged and delivered. `age_below_minimum` is a minor-safety signal and a count only — never who, never what age.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 41
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum by (reason) (rate(chat_profiles_refused_total[15m]))",
          "legendFormat": "{{reason}}/s"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Delivery latency",
      "description": "Accepted to handed to the partner's socket, by route. `remote` crossed Redis Pub/Sub to another instance; both routes are normal (D9), and a gap between them is the cost of the fan-out.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, route) (rate(chat_delivery_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{route}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(chat_delivery_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{route}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le, route) (rate(chat_delivery_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 {{route}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Process",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 55
      }
    },
    {
      "type": "timeseries",
      "title": "Event-loop lag and memory",
      "description": "Event-loop lag is the first thing to move when a socket fan-out costs more than it should.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "chat_process_nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "lag p99 {{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "chat_process_process_resident_memory_bytes",
          "legendFormat": "rss {{instance}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Database writes and the spool",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 64
      }
    },
    {
      "type": "timeseries",
      "title": "Batch write latency and failures",
      "description": "Never log a pg error object — driver errors echo parameter values, which on this path is the row that was just being inserted. `dbErrorFields()` emits SQLSTATE only, and that code is the label here.",
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 65
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chat_db_write_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(chat_db_write_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99"
        },
        {
          "refId": "C",
          "expr": "sum by (code) (rate(chat_db_write_failures_total[$__rate_interval]))",
          "legendFormat": "failed: {{code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Breaker transitions",
      "description": "The breaker's reaction time is BREAKER_FAILURE_THRESHOLD x DATABASE_STATEMENT_TIMEOUT_MS — 50s at the defaults. That is the outage that must elapse before the spool comes into play; change one and the other needs revisiting.",
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 65
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (to) (increase(chat_db_breaker_transitions_total[$__rate_interval]))",
          "legendFormat": "to {{to}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Spool writes, drains and expiries",
      "description": "The spool is bounded outage tolerance and NOT durable storage (D28) — a host failure loses it. Never describe it otherwise here or anywhere else.",
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 73
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chat_spool_writes_total[$__rate_interval]))",
          "legendFormat": "written"
        },
        {
          "refId": "B",
          "expr": "sum(rate(chat_spool_drained_total[$__rate_interval]))",
          "legendFormat": "drained"
        },
        {
          "refId": "C",
          "expr": "sum(rate(chat_spool_expired_total[$__rate_interval]))",
          "legendFormat": "expired for age"
        },
        {
          "refId": "D",
          "expr": "sum(rate(chat_spool_corrupt_records_total[$__rate_interval]))",
          "legendFormat": "corrupt"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Match attempts against matches made",
      "description": "An attempt is one tryMatch invocation whatever came back. A rising ratio of attempts to matches is the retry loop working harder — usually stale queue entries or blocked candidates being walked past.",
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 73
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(chat_match_attempts_total[$__rate_interval]))",
          "legendFormat": "attempts"
        },
        {
          "refId": "B",
          "expr": "sum(rate(chat_matches_created_total[$__rate_interval]))",
          "legendFormat": "matches"
        }
      ]
    },
    {
      "type": "row",
      "title": "AI personas — off by default, absent is correct",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 81
      }
    },
    {
      "type": "timeseries",
      "title": "Conversations, replies and withdrawals",
      "description": "A persona is an ordinary client: a real socket, the ordinary queue, the ordinary tryMatch. No branch in matchmaking, which is why blocks, bans, rate limits and retention apply to it without anybody writing code to make them.",
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 82
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(chat_persona_conversations_total[$__rate_interval]))",
          "legendFormat": "conversations: {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(chat_persona_replies_total[$__rate_interval]))",
          "legendFormat": "replies"
        },
        {
          "refId": "C",
          "expr": "sum(rate(chat_persona_withdrawn_total[$__rate_interval]))",
          "legendFormat": "withdrawn"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Replies per conversation, and the wait before a fill",
      "description": "A3's fill policy: how long somebody waited before a persona was dispatched to them. Personas must never displace a human who was available.",
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 82
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chat_persona_replies_per_conversation_bucket[$__rate_interval])))",
          "legendFormat": "replies p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(chat_persona_wait_before_fill_seconds_bucket[$__rate_interval])))",
          "legendFormat": "wait p90"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Provider latency, and sessions flagged by the guard",
      "description": "The six safety limits sit between the model and the socket, not in the prompt (D-AI-5): a limit written into a system prompt is one the thing generating text can be talked around.",
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 90
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(chat_persona_provider_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{provider}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(chat_persona_sessions_flagged_total[$__rate_interval]))",
          "legendFormat": "flagged: {{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Limit trips and fill suppression",
      "description": "A fill policy that has quietly stopped filling looks identical to one with nothing to fill, unless every reason is already on the graph at zero — which is why they are zero-initialised.",
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 90
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 12,
            "showPoints": "never"
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (limit) (rate(chat_persona_limit_trips_total[$__rate_interval]))",
          "legendFormat": "tripped: {{limit}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(chat_persona_fill_suppressed_total[$__rate_interval]))",
          "legendFormat": "suppressed: {{reason}}"
        },
        {
          "refId": "C",
          "expr": "sum(rate(chat_persona_fill_dispatched_total[$__rate_interval]))",
          "legendFormat": "dispatched"
        }
      ]
    },
    {
      "type": "row",
      "title": "Capacity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 98
      }
    },
    {
      "type": "timeseries",
      "title": "Headroom — connections against the derived ceiling",
      "description": "chat_connections_limit is derived from the box's core count (cores x CONNECTIONS_PER_CORE), so it differs per deployment. Charting the ratio rather than the count is what keeps this panel true when the tier changes. Measured on 1 vCPU: the core saturates around 2,000 concurrent, and the default ceiling of 1400/core sits below that deliberately. A second series charts the same count against the ceiling minus the resumption reserve (D63), which is where a first-time visitor is actually refused: the reserve comes out of the limit rather than extending it, so headroom read against chat_connections_limit alone is 5% more generous than the one people meet.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 99
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "max by (instance) (chat_connections_active / chat_connections_limit)",
          "legendFormat": "{{instance}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "max by (instance) (chat_connections_active / (chat_connections_limit - chat_connections_reserved))",
          "legendFormat": "{{instance}} - against what new arrivals may have"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Refused at capacity",
      "description": "chat_connections_rejected_total{reason=\"at_capacity\"} is zero-initialised, so a flat zero means the ceiling has never bound rather than that nothing is watching. Any value above zero is people being turned away: check the headroom panel beside this one before raising the ceiling, because the ceiling exists to stop the box collapsing and raising it past what the cores serve just moves the failure from a refusal to latency for everybody. The two reserve series are the trade, both directions: `at_capacity_reserved` is cold arrivals turned away to keep the last seats free, and `chat_resume_reserve_admissions_total` is resumptions that took one of those seats - a conversation that would otherwise have ended for two people. Reserved refusals with no admissions beside them over a sustained period means the reserve is larger than the drop rate needs.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 99
      },
      "datasource": {
        "type": "prometheus",
        "uid": "karobakbak-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_connections_rejected_total{reason=\"at_capacity\"}[$__rate_interval]))",
          "legendFormat": "refused at capacity"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(chat_connections_active)",
          "legendFormat": "connections held"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_connections_rejected_total{reason=\"at_capacity_reserved\"}[$__rate_interval]))",
          "legendFormat": "refused so a resumption could come back"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "karobakbak-prometheus"
          },
          "expr": "sum(rate(chat_resume_reserve_admissions_total[$__rate_interval]))",
          "legendFormat": "conversations the reserve saved"
        }
      ]
    }
  ]
